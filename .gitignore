# Dependencies
node_modules

# IDE
.vscode/
!.vscode/settings.json
!.vscode/tailwind.json
!.vscode/README.md

# Debug
firebase-debug.log
firestore-debug.log
bash.exe.stackdump

# Env Variables
.env
.env.*

# Mastra build output and local dev database
.mastra/
!.env.template

# Ngrok config (contains personal authtoken)
ngrok.yml

# Claude Code files - keep *.local.json ignored
.claude/*.local.json

# Personal documentation files
.dev

# SuperDesign files
.superdesign/

# Build artifacts
packages/*/dist/
apps/*/dist/
*.tsbuildinfo

# Deployment records: ephemeral local chains are regenerated by `pnpm deploy:local`,
# but real network deployments (amoy.json, polygon.json, …) are tracked on purpose —
# they are the record of what is deployed where.
packages/contracts/deployments/localhost.json
packages/contracts/deployments/hardhat.json
packages/contracts/deployments/hardhatFork.json

# Coverage reports (keep merge script and config files)
coverage/
!coverage/.gitkeep
packages/*/coverage/
apps/*/coverage/