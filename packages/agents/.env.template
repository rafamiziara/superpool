# Copy to `.env` and fill in. `.env` is gitignored; this file is not.

# ---------------------------------------------------------------------------
# The seam with the backend
#
# `packages/backend` is this service's only client. It signs a 60-second HS256
# token with this secret and sends it as a bearer header; `MastraJwtAuth` here
# verifies it and asks nothing else, because every caller that holds the secret
# is the backend.
#
# The two files must carry the same value — a mismatch is a 401 on every call,
# which the backend reports as "unreachable" rather than crashing the caller.
# ---------------------------------------------------------------------------

MASTRA_JWT_SECRET=a_long_random_string_shared_with_packages_backend

# ---------------------------------------------------------------------------
# The model
#
# The provider key the assessment agent spends. It lives here and nowhere
# else — not in packages/backend/.env, and never in the app: the backend
# reaches a model only by asking this service, so exactly one thing can spend
# it.
#
# The `ping` workflow calls no model and keeps working without this, which is
# what lets the seam be checked whether or not a key is set.
# ---------------------------------------------------------------------------

ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Local Studio only
#
# Mastra Studio cannot sign a service token, so auth has to come off to use it.
# Never set this where a real key is: it turns an endpoint that spends money
# into an unauthenticated one.
# ---------------------------------------------------------------------------

# MASTRA_DISABLE_AUTH=true
