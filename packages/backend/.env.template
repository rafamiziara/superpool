# Firebase App ID for App Check
APP_ID_FIREBASE=your_firebase_app_id

# ---------------------------------------------------------------------------
# Blockchain configuration
#
# The backend serves EVERY chain configured here at once — the mobile app's
# network picker is only real if more than one is set up. Configuration is per
# chain, keyed by chain id in the variable name.
#
# The factory address is what makes a chain servable: a chain with an RPC URL
# and no POOL_FACTORY_ADDRESS_<id> is ignored.
# ---------------------------------------------------------------------------

# Localhost (Hardhat). The address changes on every `pnpm deploy:local`.
POOL_FACTORY_ADDRESS_31337=0x...
RPC_URL_31337=http://127.0.0.1:8545
CHAIN_NAME_31337=Localhost
# A local node is short and disposable, so the sweep reads it from genesis.
START_BLOCK_31337=0

# Polygon Amoy (uncomment and update to serve it as well as, not instead of,
# localhost).
# POOL_FACTORY_ADDRESS_80002=0x...
# RPC_URL_80002=https://rpc-amoy.polygon.technology/
# CHAIN_NAME_80002=Polygon Amoy
# The factory's deployment block. Without it a first sweep looks back only a
# short window and everything older is invisible until you set this and
# re-run `syncPoolEventsNow` with `fromBlock`.
# START_BLOCK_80002=

# Which chain a request that names none is about. Defaults to CHAIN_ID below,
# then to 31337.
# DEFAULT_CHAIN_ID=31337

# ---------------------------------------------------------------------------
# Legacy single-chain variables.
#
# Still honoured, so an existing .env keeps working and `pnpm deploy:local` can
# go on printing these lines to paste. They configure ONE chain; the suffixed
# form above is what serves several. If both name the same chain id, the
# suffixed form wins.
# ---------------------------------------------------------------------------
# CHAIN_ID=31337
# CHAIN_NAME=Localhost
# RPC_URL=http://127.0.0.1:8545
# POOL_FACTORY_ADDRESS=0x...
# START_BLOCK=

# Backend Wallet (for automated whitelisting transactions)
# SECURITY: Keep this private key secure. Never commit the actual .env file.
# One key is used for every configured chain, so it needs gas on each of them.
BACKEND_WALLET_PRIVATE_KEY=0x...

# ---------------------------------------------------------------------------
# The assessment agent (packages/agents)
#
# Both are needed or the backend treats the agent as absent, which is the right
# default: it is an optional dependency, and the approvals queue works without
# it. MASTRA_JWT_SECRET must match packages/agents/.env exactly.
#
# The provider key lives with the agent, never here.
# ---------------------------------------------------------------------------

# AGENT_SERVICE_URL=http://localhost:4111
# MASTRA_JWT_SECRET=a_long_random_string_shared_with_packages_agents

# How many readings one wallet may pay for in a day. Bounds the accident — a
# loop, a stuck refresh, a screen left open — rather than rationing ordinary
# use. Only readings actually made are counted. Defaults to 50.
# ASSESSMENT_DAILY_CAP=50
