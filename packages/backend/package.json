{
  "name": "backend",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "serve": "npm run build && cd ../../config && firebase emulators:start --inspect-functions",
    "shell": "npm run build && cd ../../config && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "cd ../../config && firebase deploy --only functions",
    "logs": "cd ../../config && firebase functions:log",
    "generateKey": "tsx scripts/generateKey.ts",
    "signMessage": "tsx scripts/signMessage.ts",
    "testIndexer": "tsx scripts/testEventIndexer.ts",
    "testSweep": "tsx scripts/testEventSweep.ts",
    "testInterest": "tsx scripts/testInterestClaims.ts",
    "testHistory": "tsx scripts/testBorrowerHistory.ts",
    "testPartial": "tsx scripts/testPartialRepayment.ts",
    "testAccrual": "tsx scripts/testAccruedInterest.ts",
    "testErc20": "tsx scripts/testErc20Pools.ts",
    "testDecisions": "tsx scripts/testDecisions.ts",
    "testSearch": "tsx scripts/testSearch.ts",
    "testReceipts": "tsx scripts/testReceipts.ts",
    "testDefaults": "tsx scripts/testDefaults.ts",
    "testNotes": "tsx scripts/testNotes.ts",
    "testAgentSeam": "tsx scripts/testAgentSeam.ts",
    "testAssessment": "tsx scripts/testAssessment.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "type-check:prod": "tsc --noEmit -p tsconfig.build.json",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@mastra/client-js": "^1.40.0",
    "@superpool/types": "workspace:*",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.4.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@vitest/coverage-v8": "^5.0.0",
    "firebase-functions-test": "^3.4.1",
    "minimatch": "^10.0.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "private": true
}
