{
  "name": "backend",
  "scripts": {
    "lint": "eslint src --config ../../eslint.config.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "serve": "npm run build && cd ../../config && firebase emulators:start --inspect-functions",
    "shell": "npm run build && cd ../../config && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "cd ../../config && firebase deploy --only functions",
    "logs": "cd ../../config && firebase functions:log",
    "generateKey": "ts-node scripts/generateKey.ts",
    "signMessage": "ts-node scripts/signMessage.ts",
    "testIndexer": "ts-node scripts/testEventIndexer.ts",
    "testSweep": "ts-node scripts/testEventSweep.ts",
    "testInterest": "ts-node scripts/testInterestClaims.ts",
    "testHistory": "ts-node scripts/testBorrowerHistory.ts",
    "testPartial": "ts-node scripts/testPartialRepayment.ts",
    "test": "jest",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "type-check": "tsc --noEmit",
    "type-check:prod": "tsc --noEmit -p tsconfig.build.json"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@superpool/types": "workspace:*",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.4.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "firebase-functions-test": "^3.4.1",
    "jest": "^30.0.5",
    "minimatch": "^10.0.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
