{
  "name": "@superpool/types",
  "version": "0.1.0",
  "description": "SuperPool shared TypeScript types and interfaces",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "keywords": [
    "typescript",
    "types",
    "interfaces",
    "superpool"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rafamiziara/superpool.git",
    "directory": "packages/types"
  },
  "license": "MIT"
}
