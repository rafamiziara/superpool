{
  "extends": "@rm30/tsconfig/base.json",
  "compilerOptions": {
    // Emit is on here: packages/types builds declarations from this base.
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "types": []
  },
  "exclude": ["node_modules", "dist", "build", "coverage", "**/*.test.*", "**/*.spec.*"]
}
